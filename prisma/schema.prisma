generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id             String    @id @default(cuid())
  businessName   String
  website        String?
  email          String?
  phone          String?
  whatsapp       String?
  industry       String?
  location       String?
  notes          String?
  status         String    @default("new")
  score          Int       @default(0)

  instagram      String?
  facebook       String?
  linkedin       String?
  youtube        String?
  twitter        String?
  gmb            String?

  address        String?
  rating         Float?
  reviewCount    Int?
  mapUrl         String?

  websiteScore   Int?
  socialScore    Int?
  gaps           String?
  weaknesses     String?
  outreachAngle  String?
  lastResearched DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outreachLogs OutreachLog[]
  followUps    FollowUp[]
  proposals    Proposal[]
  bulkEmails   BulkEmail[]
}

model OutreachLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  channel   String   @default("email")
  sentAt    DateTime @default(now())
  opened    Boolean  @default(false)
  replied   Boolean  @default(false)
}

model FollowUp {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message     String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model Proposal {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title        String
  services     String   // JSON array of selected services
  body         String   // full proposal markdown
  pricingTier  String   @default("standard")
  status       String   @default("draft") // draft, sent, accepted, rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CaseStudy {
  id           String   @id @default(cuid())
  clientType   String   // e.g. "Restaurant in Mumbai"
  service      String   // e.g. "Instagram Management"
  result       String   // e.g. "800 followers in 60 days"
  duration     String?  // e.g. "3 months"
  details      String?  // longer description
  createdAt    DateTime @default(now())
}

model Campaign {
  id          String      @id @default(cuid())
  name        String
  status      String      @default("draft")
  targetNiche String?
  targetCity  String?
  totalLeads  Int         @default(0)
  contacted   Int         @default(0)
  replied     Int         @default(0)
  converted   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bulkEmails  BulkEmail[]
}

model BulkEmail {
  id         String    @id @default(cuid())
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject    String
  body       String
  status     String    @default("pending") // pending, approved, sent, failed
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Content {
  id        String   @id @default(cuid())
  type      String
  platform  String?
  title     String?
  body      String
  tags      String?
  industry  String?
  createdAt DateTime @default(now())
}
